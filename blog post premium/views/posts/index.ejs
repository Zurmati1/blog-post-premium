<!DOCTYPE html><html><head><script src="https://cdn.tailwindcss.com"></script><title>Luxury Blog</title></head><body class='bg-gradient-to-br from-amber-50 to-white min-h-screen text-gray-800'><nav class='bg-black text-amber-300 p-4 flex justify-between'><a href='/posts' class='font-bold'>Luxury Blog</a><div><% if(user){ %><a href='/posts/new'>New</a> <a href='/logout'>Logout</a><% } else { %><a href='/login'>Login</a><% } %></div></nav><div class='max-w-6xl mx-auto p-6'><h1 class='text-4xl font-bold mb-6'>Premium Blog Posts</h1><div class='grid md:grid-cols-2 gap-6'><% posts.forEach(p=>{ %><div class='bg-white rounded-2xl shadow-xl overflow-hidden'><img src='<%= p.image || "https://picsum.photos/600/300" %>' class='w-full h-48 object-cover'><div class='p-5'><h2 class='text-2xl font-bold'><%= p.title %></h2><p class='text-sm text-gray-500'><%= p.author %> • <%= p.category %></p><p class='mt-3'><%= p.content.substring(0,120) %>...</p><% if(user){ %><div class='mt-3'><a href='/posts/<%= p._id %>/edit' class='text-blue-600'>Edit</a><form method='post' action='/posts/<%= p._id %>/delete'><button class='text-red-600'>Delete</button></form></div><% } %></div></div><% }) %></div></div></body></html>